<?xml version="1.0" encoding="utf-8"?>
<!-- The one video surface (full screen and the corner mini player). A SurfaceView, not a
     TextureView: only a SurfaceView hands the video straight to the display, which is what lets
     HDR play as HDR (the TV switches mode) instead of being tone-mapped into washed-out SDR. It
     punches through the guide where it's drawn, so it still layers in order with the UI. -->
<androidx.media3.ui.PlayerView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:focusable="false"
    app:surface_type="surface_view"
    app:use_controller="false"
    app:resize_mode="fit"
    app:show_buffering="always"
    android:background="@android:color/black"
    app:shutter_background_color="@android:color/black" />
