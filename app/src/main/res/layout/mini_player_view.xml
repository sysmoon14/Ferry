<?xml version="1.0" encoding="utf-8"?>
<!-- PlayerView for the corner mini player. A TextureView (not the default SurfaceView) so it
     clips to the rounded tile and draws in order with the guide around it. -->
<androidx.media3.ui.PlayerView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:focusable="false"
    app:surface_type="texture_view"
    app:use_controller="false"
    app:resize_mode="fit"
    app:show_buffering="always"
    android:background="@android:color/black"
    app:shutter_background_color="@android:color/black" />
